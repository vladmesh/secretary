[Unit]
Description=Secretary steward daily deep sweep
After=orca-server.service network-online.target
Wants=orca-server.service

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/home/dev/orca/workspaces/secretary/steward
Environment=HOME=/home/dev
Environment=TA_RUNTIME_PYTHONPATH=/home/dev/secretary
Environment=TA_RUNTIME_ENV_FILE=/home/dev/secretary-instance/runtime.env
ExecStart=/home/dev/secretary/scripts/secretary-agent-gate.sh steward deep-sweep
