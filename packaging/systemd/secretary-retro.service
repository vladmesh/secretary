[Unit]
Description=Secretary retro tick
After=orca-server.service network-online.target

[Service]
Type=oneshot
# A local-pty head deliberately outlives the short scheduler tick. The runtime owns that
# supervisor through its socket and identity record; ending this oneshot must not SIGTERM it.
KillMode=process
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_RUNTIME_HOME}}/orca/workspaces/secretary/retro
Environment=HOME={{SECRETARY_RUNTIME_HOME}}
Environment=TA_RUNTIME_PYTHONPATH={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_SECRETARY_REPO={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_INSTANCE={{SECRETARY_INSTANCE_PATH}}
ExecStart={{SECRETARY_PRODUCT_ROOT}}/scripts/secretary-agent-gate.sh retro
