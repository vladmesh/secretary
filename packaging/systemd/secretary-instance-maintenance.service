[Unit]
Description=Secretary instance repository maintenance (git gc outside any tick)
After=network-online.target

[Service]
Type=oneshot
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_PRODUCT_ROOT}}
EnvironmentFile=-{{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=HOME={{SECRETARY_RUNTIME_HOME}}
Environment=SECRETARY_INSTANCE={{SECRETARY_INSTANCE_PATH}}
Environment=TA_SECRETARY_REPO={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=PATH={{SECRETARY_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Packing yields to the ticks: it never takes the state-repo lock while it packs, and it gets
# the CPU and disk only when nothing else wants them.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
ExecStart={{SECRETARY_PRODUCT_ROOT}}/.venv/bin/secretary instance-maintenance --instance {{SECRETARY_INSTANCE_PATH}}
