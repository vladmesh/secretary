[Unit]
Description=Secretary web transport (loopback only; published by secretary-web-front.service)
After=network.target

[Service]
Type=simple
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_PRODUCT_ROOT}}
EnvironmentFile=-{{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_INSTANCE={{SECRETARY_INSTANCE_PATH}}
Environment=TA_SECRETARY_REPO={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_DATA_DIR={{SECRETARY_DATA_DIR}}
Environment=PATH={{SECRETARY_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 127.0.0.1 is not a default this unit may relax: the transport has no password of its own and its
# POST routes raise real heads, so the guarded front is the only path in from off this host.
ExecStart={{SECRETARY_PRODUCT_ROOT}}/.venv/bin/secretary web-serve --instance {{SECRETARY_INSTANCE_PATH}} --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
