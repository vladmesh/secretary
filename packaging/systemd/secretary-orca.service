[Unit]
Description=Secretary Orca runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_RUNTIME_HOME}}
Environment=HOME={{SECRETARY_RUNTIME_HOME}}
ExecStart={{SECRETARY_ORCA_EXECUTABLE}} serve --port 6768 --pairing-address 127.0.0.1
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
