[Unit]
Description=Secretary steward tick
After=orca-server.service network-online.target
Wants=orca-server.service

[Service]
Type=oneshot
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_RUNTIME_HOME}}/orca/workspaces/secretary/steward
Environment=HOME={{SECRETARY_RUNTIME_HOME}}
Environment=TA_RUNTIME_PYTHONPATH={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
ExecStart={{SECRETARY_PRODUCT_ROOT}}/scripts/secretary-agent-gate.sh steward
