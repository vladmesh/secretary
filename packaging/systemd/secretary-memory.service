[Unit]
Description=Secretary shared semantic memory MCP
After=network.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/secretary
# Canon is the private instance repo; export and index stay derived in secretary-data.
Environment=MEMORY_CANON_ROOT=/home/dev/secretary-instance/state/memory/facts
Environment=MEMORY_CANON_EXPORT=/home/dev/secretary-data/memory/export.ndjson
Environment=MEMORY_DB=/home/dev/secretary-data/memory/index.sqlite
Environment=MEMORY_MODEL=intfloat/multilingual-e5-large
Environment=MEMORY_DIM=1024
Environment=MEMORY_PORT=8077
ExecStart=/home/dev/secretary/.venv/bin/secretary-memory-mcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
