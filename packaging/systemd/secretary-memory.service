[Unit]
Description=Secretary shared semantic memory MCP
After=network.target

[Service]
Type=simple
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_PRODUCT_ROOT}}
# Canon is the private instance repo; export and index stay derived in secretary-data.
Environment=MEMORY_CANON_ROOT={{SECRETARY_INSTANCE_PATH}}/state/memory/facts
Environment=MEMORY_CANON_EXPORT={{SECRETARY_DATA_DIR}}/memory/export.ndjson
Environment=MEMORY_DB={{SECRETARY_DATA_DIR}}/memory/index.sqlite
Environment=MEMORY_CACHE_DIR={{SECRETARY_DATA_DIR}}/memory/fastembed-cache
Environment=MEMORY_MODEL={{SECRETARY_MEMORY_MODEL}}
Environment=MEMORY_DIM={{SECRETARY_MEMORY_DIM}}
Environment=MEMORY_THREADS={{SECRETARY_MEMORY_THREADS}}
Environment=MEMORY_PORT=8077
ExecStart={{SECRETARY_PRODUCT_ROOT}}/.venv/bin/secretary-memory-mcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
