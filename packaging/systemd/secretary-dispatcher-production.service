[Unit]
Description=Secretary production dispatcher tick
After=network-online.target orca-server.service
Wants=network-online.target orca-server.service

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/home/dev/secretary
EnvironmentFile=/home/dev/secretary-instance/runtime.env
Environment=SECRETARY_INSTANCE=/home/dev/secretary-instance
Environment=SECRETARY_DISPATCHER_OWNER=secretary-production
ExecStart=/home/dev/secretary/.venv/bin/secretary dispatcher production-run --instance /home/dev/secretary-instance
