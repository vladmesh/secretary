[Unit]
Description=Secretary production dispatcher tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A local-pty head deliberately outlives the short scheduler tick. The runtime owns that
# supervisor through its socket and identity record; ending this oneshot must not SIGTERM it.
KillMode=process
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_PRODUCT_ROOT}}
EnvironmentFile=-{{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_INSTANCE={{SECRETARY_INSTANCE_PATH}}
Environment=TA_SECRETARY_REPO={{SECRETARY_PRODUCT_ROOT}}
Environment=SECRETARY_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_DISPATCHER_OWNER=secretary-production
Environment=PATH={{SECRETARY_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{SECRETARY_PRODUCT_ROOT}}/.venv/bin/python3 -I {{SECRETARY_PRODUCT_ROOT}}/src/secretary/dispatch/runtime_preflight.py --product-root {{SECRETARY_PRODUCT_ROOT}} --interpreter {{SECRETARY_PRODUCT_ROOT}}/.venv/bin/python3 --data-dir {{SECRETARY_DATA_DIR}} -- {{SECRETARY_PRODUCT_ROOT}}/.venv/bin/secretary dispatcher production-tick --instance {{SECRETARY_INSTANCE_PATH}}
