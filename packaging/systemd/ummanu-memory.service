[Unit]
Description=Ummanu shared semantic memory MCP
After=network.target

[Service]
Type=simple
User={{UMMANU_RUNTIME_USER}}
Group={{UMMANU_RUNTIME_USER}}
WorkingDirectory={{UMMANU_PRODUCT_ROOT}}
# Canon is the private instance repo; export and index stay derived in ummanu-data.
Environment=MEMORY_CANON_ROOT={{UMMANU_INSTANCE_PATH}}/state/memory/facts
Environment=MEMORY_CANON_EXPORT={{UMMANU_DATA_DIR}}/memory/export.ndjson
Environment=MEMORY_DB={{UMMANU_DATA_DIR}}/memory/index.sqlite
Environment=MEMORY_CACHE_DIR={{UMMANU_DATA_DIR}}/memory/fastembed-cache
Environment=MEMORY_MODEL={{UMMANU_MEMORY_MODEL}}
Environment=MEMORY_DIM={{UMMANU_MEMORY_DIM}}
Environment=MEMORY_THREADS={{UMMANU_MEMORY_THREADS}}
Environment=MEMORY_PORT=8077
Environment=MEMORY_ACCESS_BINDINGS={{UMMANU_DATA_DIR}}/memory/access-grants
ExecStart={{UMMANU_PRODUCT_ROOT}}/.venv/bin/ummanu-memory-mcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
