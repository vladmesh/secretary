[Unit]
Description=Secretary PO head service (the one owner of PO turns; fed by DATA_DIR/po-queue over DATA_DIR/po-service/po.sock)
After=network.target

[Service]
Type=simple
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_PRODUCT_ROOT}}
EnvironmentFile=-{{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_INSTANCE={{SECRETARY_INSTANCE_PATH}}
Environment=TA_SECRETARY_REPO={{SECRETARY_PRODUCT_ROOT}}
Environment=TA_RUNTIME_ENV_FILE={{SECRETARY_INSTANCE_PATH}}/runtime.env
Environment=SECRETARY_DATA_DIR={{SECRETARY_DATA_DIR}}
Environment=PATH={{SECRETARY_RUNTIME_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# No PartOf=/BindsTo= the web: restarting the web must not touch a running turn. A turn is a child in
# this unit's control group, so a restart of this unit ends it; `secretary upgrade` therefore only asks
# for a restart, and the service exits by itself (status 0) once no turn runs. Restart=always brings it
# back on the new code, and the queue on disk is taken up where it was.
ExecStart={{SECRETARY_PRODUCT_ROOT}}/.venv/bin/secretary po-serve --instance {{SECRETARY_INSTANCE_PATH}}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
