[Unit]
Description=Secretary web front: Caddy with TLS and a password over the loopback web transport
After=network-online.target secretary-web.service
Wants=network-online.target
# The front is the published half and the transport is the private half of one service. PartOf
# makes them stop and restart together, so the pair is never half-running in either direction.
Requires=secretary-web.service
PartOf=secretary-web.service

[Service]
Type=simple
User={{SECRETARY_RUNTIME_USER}}
Group={{SECRETARY_RUNTIME_USER}}
WorkingDirectory={{SECRETARY_DATA_DIR}}/webfront
Environment=HOME={{SECRETARY_RUNTIME_HOME}}
Environment=XDG_DATA_HOME={{SECRETARY_DATA_DIR}}/webfront
Environment=XDG_CONFIG_HOME={{SECRETARY_DATA_DIR}}/webfront
# Ports 80 and 443 without running as root. Nothing else about this host is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# The configuration is rendered from the secret store by `secretary web-front render`; it carries a
# bcrypt hash, so it is mode 0600 machine state under the data directory and never a tracked file.
ExecStartPre=/usr/bin/caddy validate --adapter caddyfile --config {{SECRETARY_DATA_DIR}}/webfront/Caddyfile
ExecStart=/usr/bin/caddy run --adapter caddyfile --config {{SECRETARY_DATA_DIR}}/webfront/Caddyfile
ExecReload=/usr/bin/caddy reload --adapter caddyfile --config {{SECRETARY_DATA_DIR}}/webfront/Caddyfile --force
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
