[Unit]
Description=Create secretary core and full backups
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/home/dev/secretary
EnvironmentFile=/home/dev/secretary-instance/runtime.env
ExecStart=/home/dev/secretary/.venv/bin/secretary backup create --instance /home/dev/secretary-instance --kind both
