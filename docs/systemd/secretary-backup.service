[Unit]
Description=Create secretary core and full backups
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dev
WorkingDirectory=/home/dev/secretary
EnvironmentFile=/home/dev/control-panel/.env
Environment=PYTHONPATH=/home/dev/secretary
ExecStart=/usr/bin/python3 -m secretary backup create --instance /home/dev/secretary-instance --kind both
