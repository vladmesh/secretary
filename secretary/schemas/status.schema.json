{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/invalid"}
  ],
  "$defs": {
  "snapshot": {
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation", "host", "dispatcher", "checkpoint", "memory"],
  "properties": {
    "schema_version": {"const": 1},
    "installation": {"type": "object", "required": ["name", "instance", "projects", "heads", "cards"], "properties": {"cards": {"type": "object", "required": ["total", "active_attempts"]}}},
    "host": {"type": "object", "required": ["units", "schedules", "inventory_errors", "resources"], "properties": {"resources": {"type": "object", "required": ["disk_free_bytes", "memory_available_bytes", "load_average"]}}},
    "dispatcher": {"type": "object", "required": ["phase", "active_attempts", "pause", "divergences", "reconciliation"], "properties": {"pause": {"type": "object", "required": ["paused", "mode", "since", "actor", "auto_resume", "cards", "warnings"]}, "active_attempts": {"type": "array", "items": {"type": "object", "required": ["reference", "attempt_id", "head", "workspace", "watchdogs", "paused"], "properties": {"watchdogs": {"type": "object", "required": ["worker", "reviewer"]}}}}, "divergences": {"type": "object", "required": ["open_count", "total_count", "open"]}, "reconciliation": {"type": "object", "required": ["last_tick_finished_at", "records_tracked"]}}},
    "checkpoint": {"type": "object", "required": ["last_commit", "lag_minutes", "remote_diverged", "blocked_reason"]},
    "memory": {"type": "object", "required": ["fact_count", "last_reindex_at", "index_present"]}
  }
  },
  "invalid": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "error", "findings"],
    "properties": {
      "schema_version": {"const": 1},
      "error": {"const": "invalid_instance"},
      "findings": {"type": "array", "items": {"type": "string"}}
    }
  }
  }
}
