{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/invalid"}
  ],
  "$defs": {
  "snapshot": {
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation", "host", "dispatcher", "checkpoint", "memory", "secret_store"],
  "properties": {
    "schema_version": {"const": 1},
    "installation": {
      "type": "object",
      "required": ["name", "instance", "projects", "heads", "head_registry", "cards", "sprints"],
      "properties": {
        "cards": {"type": "object", "required": ["total", "active_attempts"]},
        "head_registry": {
          "type": "object",
          "required": ["snapshot", "product_root", "revision", "error"],
          "properties": {
            "snapshot": {"type": "string"},
            "product_root": {"type": ["string", "null"]},
            "revision": {"type": ["string", "null"]},
            "error": {"type": ["string", "null"]}
          }
        },
        "sprints": {
          "type": "object",
          "required": ["items", "error"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref", "goal", "status", "current_task", "cards", "budget", "resume_freshness", "stop_reason", "observer"]
              }
            },
            "error": {
              "oneOf": [
                {"type": "null"},
                {"type": "object", "required": ["code", "message"]}
              ]
            }
          }
        }
      }
    },
    "host": {"type": "object", "required": ["units", "schedules", "inventory_errors", "resources", "external_runtime"], "properties": {"resources": {"type": "object", "required": ["disk_free_bytes", "memory_available_bytes", "load_average"]}, "external_runtime": {"type": "object", "required": ["name", "enabled", "active"]}}},
    "dispatcher": {"type": "object", "required": ["phase", "active_attempts", "observers", "pause", "divergences", "reconciliation"], "properties": {"pause": {"type": "object", "required": ["paused", "mode", "since", "actor", "auto_resume", "cards", "warnings"]}, "active_attempts": {"type": "array", "items": {"type": "object", "required": ["reference", "attempt_id", "head", "workspace", "watchdogs", "paused"], "properties": {"watchdogs": {"type": "object", "required": ["worker", "reviewer"]}}}}, "observers": {"type": "array", "items": {"type": "object", "required": ["sprint", "head", "state", "alive", "launches", "last_action", "last_action_at", "deferred_reason"]}}, "divergences": {"type": "object", "required": ["open_count", "total_count", "open"]}, "reconciliation": {"type": "object", "required": ["last_tick_finished_at", "last_reconciled_at", "records_tracked"]}}},
    "checkpoint": {"type": "object", "required": ["last_commit", "lag_minutes", "remote_diverged", "blocked_reason"]},
    "memory": {"type": "object", "required": ["fact_count", "last_reindex_at", "index_present"]},
    "secret_store": {"type": "object", "required": ["initialized", "secret_count", "last_modified_at", "installation_key", "materialize"], "properties": {"installation_key": {"type": "object", "required": ["present", "usable"]}, "materialize": {"type": "array", "items": {"type": "object", "required": ["target", "path", "count"]}}}}
  }
  },
  "invalid": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "error", "findings"],
    "properties": {
      "schema_version": {"const": 1},
      "error": {"const": "invalid_instance"},
      "findings": {"type": "array", "items": {"type": "string"}}
    }
  }
  }
}
