{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation", "host", "dispatcher", "checkpoint", "memory"],
  "properties": {
    "schema_version": {"const": 1},
    "installation": {"type": "object", "required": ["name", "instance", "projects", "heads", "cards"]},
    "host": {"type": "object", "required": ["units", "inventory_errors", "resources"]},
    "dispatcher": {"type": "object", "required": ["phase", "active_attempts"]},
    "checkpoint": {"type": "object", "required": ["last_commit", "lag_minutes", "remote_diverged", "blocked_reason"]},
    "memory": {"type": "object", "required": ["fact_count", "last_reindex_at", "index_present"]}
  }
}
