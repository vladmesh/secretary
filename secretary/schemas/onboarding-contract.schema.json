{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding-contract.schema.json",
  "title": "Project onboarding contract",
  "description": "Versioned Phase 6 artifact for scanner output, draft binding/adapter, provision result and onboarding gate result. Binding identity (id, repo, adapter, default_branch) lives once in the top-level identity object; each stage only records the mutable enabled bit, so identity cannot diverge between draft, provision and gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identity", "scanner", "draft", "provision", "gate", "ownership"],
  "properties": {
    "version": {"const": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "scanner": {"$ref": "#/$defs/scanner"},
    "draft": {"$ref": "#/$defs/draft"},
    "provision": {"$ref": "#/$defs/provision"},
    "gate": {"$ref": "#/$defs/gate"},
    "ownership": {"$ref": "#/$defs/ownership"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "draft": {
            "properties": {
              "adapter": {
                "properties": {"status": {"const": "unresolved"}},
                "required": ["status"]
              }
            },
            "required": ["adapter"]
          },
          "provision": {
            "properties": {"status": {"const": "pending"}},
            "required": ["status"]
          }
        },
        "required": ["draft", "provision"]
      },
      "then": {
        "properties": {
          "ownership": {
            "properties": {
              "adapter": {
                "properties": {
                  "storage": {"const": "secretary-instance/adapter-drafts/<project>.yaml"}
                },
                "required": ["storage"]
              }
            },
            "required": ["adapter"]
          }
        },
        "required": ["ownership"]
      }
    },
    {
      "if": {
        "properties": {
          "gate": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}
        },
        "required": ["gate"]
      },
      "then": {
        "properties": {
          "scanner": {
            "properties": {
              "status": {"const": "ok"},
              "repo": {
                "properties": {"exists": {"const": true}},
                "required": ["exists"]
              },
              "findings": {"$ref": "#/$defs/noErrorFindings"}
            },
            "required": ["status", "repo", "findings"]
          },
          "draft": {
            "properties": {
              "findings": {"$ref": "#/$defs/noErrorFindings"}
            }
          },
          "provision": {
            "properties": {
              "status": {"const": "drafted"},
              "findings": {"$ref": "#/$defs/noErrorFindings"}
            },
            "required": ["status", "findings"]
          }
        },
        "required": ["scanner", "provision"]
      }
    },
    {
      "if": {
        "properties": {
          "gate": {
            "properties": {
              "status": {"const": "passed"},
              "checks": {
                "properties": {"validation": {"const": "declared-missing"}},
                "required": ["validation"]
              }
            },
            "required": ["status", "checks"]
          }
        },
        "required": ["gate"]
      },
      "then": {
        "properties": {
          "provision": {
            "properties": {
              "adapter": {
                "properties": {
                  "validation": {
                    "properties": {"ci": {"const": "none"}},
                    "required": ["ci", "missing"]
                  }
                },
                "required": ["validation"]
              }
            },
            "required": ["adapter"]
          }
        },
        "required": ["provision"]
      }
    },
    {
      "if": {
        "properties": {
          "gate": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "provision": {
            "properties": {
              "adapter": {
                "properties": {
                  "validation": {
                    "properties": {"ci": {"const": "none"}},
                    "required": ["ci"]
                  }
                },
                "required": ["validation"]
              }
            },
            "required": ["adapter"]
          }
        },
        "required": ["gate", "provision"]
      },
      "then": {
        "properties": {
          "gate": {
            "properties": {
              "checks": {
                "properties": {"validation": {"const": "declared-missing"}},
                "required": ["validation"]
              }
            },
            "required": ["checks"]
          }
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "adapter", "default_branch"],
      "description": "The single source of binding identity. Fixed by project add and never re-declared downstream; mutable binding fields such as plane and policy stay in the binding, so identity cannot diverge between draft, provision and gate.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repo": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1}
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "owner", "status", "repo", "facts", "findings"],
      "properties": {
        "version": {"const": 1},
        "owner": {"const": "deterministic-scanner"},
        "status": {"type": "string", "enum": ["ok", "failed"]},
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "description": "Observations about identity.repo at identity.default_branch. The scanner does not name its own repo path or branch, so it cannot scan a target other than the identity being onboarded.",
          "required": ["exists"],
          "properties": {
            "exists": {"type": "boolean"},
            "head": {"type": "string", "minLength": 1},
            "worktree_clean": {"type": "boolean"}
          }
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages", "package_managers", "ci_files", "test_files", "project_local_adapter"],
          "properties": {
            "languages": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "package_managers": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "ci_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "test_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "docs_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "setup_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "project_local_adapter": {"type": "boolean"}
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "binding", "adapter"],
      "properties": {
        "owner": {"const": "project-add"},
        "binding": {"$ref": "#/$defs/disabledStageBinding"},
        "adapter": {"$ref": "#/$defs/projectAddAdapterDraft"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "binding", "adapter", "findings"],
      "properties": {
        "owner": {"const": "provision-agent"},
        "status": {"type": "string", "enum": ["pending", "drafted", "failed"]},
        "binding": {"$ref": "#/$defs/disabledStageBinding"},
        "adapter": {"$ref": "#/$defs/projectAddAdapterDraft"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {"properties": {"adapter": {"$ref": "#/$defs/unresolvedAdapterDraft"}}}
        },
        {
          "if": {"properties": {"status": {"const": "drafted"}}, "required": ["status"]},
          "then": {"properties": {"adapter": {"$ref": "#/$defs/adapterDraft"}}}
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "checks", "binding", "findings"],
      "properties": {
        "owner": {"const": "onboarding-gate"},
        "status": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean_worktree", "setup", "smoke", "validation", "artifact_policy"],
          "properties": {
            "clean_worktree": {"type": "string", "enum": ["passed", "failed", "not-run"]},
            "setup": {"type": "string", "enum": ["passed", "failed", "not-run"]},
            "smoke": {"type": "string", "enum": ["passed", "failed", "not-run"]},
            "validation": {"type": "string", "enum": ["passed", "failed", "not-run", "declared-missing"]},
            "artifact_policy": {"type": "string", "enum": ["passed", "failed", "not-run"]}
          }
        },
        "binding": {"$ref": "#/$defs/stageBinding"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {"properties": {"binding": {"properties": {"enabled": {"const": false}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "binding": {"properties": {"enabled": {"const": true}}},
              "checks": {
                "properties": {
                  "clean_worktree": {"const": "passed"},
                  "setup": {"const": "passed"},
                  "smoke": {"const": "passed"},
                  "validation": {"enum": ["passed", "declared-missing"]},
                  "artifact_policy": {"const": "passed"}
                }
              },
              "findings": {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["severity"],
                    "properties": {"severity": {"const": "error"}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {"properties": {"binding": {"properties": {"enabled": {"const": false}}}}}
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "adapter", "enable_transition"],
      "properties": {
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft_owner", "enable_owner", "initial_enabled"],
          "properties": {
            "draft_owner": {"const": "project-add"},
            "enable_owner": {"const": "onboarding-gate"},
            "initial_enabled": {"const": false}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft_owner", "provision_owner", "storage"],
          "properties": {
            "draft_owner": {"const": "project-add"},
            "provision_owner": {"const": "provision-agent"},
            "storage": {"enum": ["secretary-instance/adapter-drafts/<project>.yaml", "secretary-instance/adapters/<project>.yaml"]}
          }
        },
        "enable_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["only_when", "forbidden_owners"],
          "properties": {
            "only_when": {"const": "gate.status == passed"},
            "forbidden_owners": {
              "type": "array",
              "prefixItems": [{"const": "deterministic-scanner"}, {"const": "project-add"}, {"const": "provision-agent"}],
              "items": false,
              "minItems": 3
            }
          }
        }
      }
    },
    "stageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "A stage's contribution to the binding: only the mutable enabled bit. Identity is read from the top-level identity object, never re-declared here.",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "disabledStageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"const": false}
      }
    },
    "adapterDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "smoke", "validation", "artifact_policy"],
      "properties": {
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands"],
          "properties": {
            "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {"type": "string", "minLength": 1}
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ci"],
          "properties": {
            "ci": {"type": "string", "enum": ["github", "local", "none"]},
            "command": {"type": "string", "minLength": 1},
            "missing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "required_checks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "allOf": [
            {
              "if": {"required": ["ci"], "properties": {"ci": {"const": "local"}}},
              "then": {"required": ["command"]}
            },
            {
              "if": {"required": ["ci"], "properties": {"ci": {"const": "none"}}},
              "then": {"required": ["missing"]}
            }
          ]
        },
        "artifact_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["write_project_files"],
          "properties": {
            "write_project_files": {"type": "boolean"}
          }
        }
      }
    },
    "unresolvedAdapterDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_decisions"],
      "properties": {
        "status": {"const": "unresolved"},
        "required_decisions": {
          "type": "array",
          "prefixItems": [
            {"const": "setup.commands"},
            {"const": "smoke.command"},
            {"const": "validation.ci"},
            {"const": "artifact_policy.write_project_files"}
          ],
          "items": false,
          "minItems": 4
        }
      }
    },
    "projectAddAdapterDraft": {
      "oneOf": [
        {"$ref": "#/$defs/unresolvedAdapterDraft"},
        {"$ref": "#/$defs/adapterDraft"}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["repo.missing", "scanner.failed", "draft.invalid", "provision.invalid", "result.foreign", "stale.input", "environment.failed", "adapter.invalid", "ci.undeclared", "project-local.denied", "publication.failed", "tests.not-observed", "ci.not-observed", "gate.failed"]
        },
        "severity": {"type": "string", "enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "noErrorFindings": {
      "type": "array",
      "not": {
        "contains": {
          "type": "object",
          "required": ["severity"],
          "properties": {"severity": {"const": "error"}}
        }
      }
    }
  }
}
