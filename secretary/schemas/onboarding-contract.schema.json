{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding-contract.schema.json",
  "title": "Project onboarding contract",
  "description": "Versioned Phase 6 artifact for scanner output, draft binding/adapter, provision result and onboarding gate result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "scanner", "draft", "provision", "gate", "ownership", "compatibility_manifest"],
  "properties": {
    "version": {"const": 1},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "scanner": {"$ref": "#/$defs/scanner"},
    "draft": {"$ref": "#/$defs/draft"},
    "provision": {"$ref": "#/$defs/provision"},
    "gate": {"$ref": "#/$defs/gate"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "compatibility_manifest": {"$ref": "#/$defs/compatibilityManifest"}
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "owner", "status", "repo", "facts", "findings"],
      "properties": {
        "version": {"const": 1},
        "owner": {"const": "deterministic-scanner"},
        "status": {"type": "string", "enum": ["ok", "failed"]},
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "exists"],
          "properties": {
            "input": {"type": "string", "minLength": 1},
            "exists": {"type": "boolean"},
            "default_branch": {"type": "string", "minLength": 1},
            "head": {"type": "string", "minLength": 1},
            "worktree_clean": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {"properties": {"exists": {"const": true}}, "required": ["exists"]},
              "then": {"required": ["default_branch"]}
            }
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages", "package_managers", "ci_files", "test_files", "project_local_adapter"],
          "properties": {
            "languages": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "package_managers": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "ci_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "test_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "project_local_adapter": {"type": "boolean"}
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "binding", "adapter"],
      "properties": {
        "owner": {"const": "project-add"},
        "binding": {"$ref": "#/$defs/disabledBinding"},
        "adapter": {"$ref": "#/$defs/adapterDraft"}
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "binding", "adapter", "findings"],
      "properties": {
        "owner": {"const": "provision-agent"},
        "status": {"type": "string", "enum": ["drafted", "failed"]},
        "binding": {"$ref": "#/$defs/disabledBinding"},
        "adapter": {"$ref": "#/$defs/adapterDraft"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "checks", "binding", "findings"],
      "properties": {
        "owner": {"const": "onboarding-gate"},
        "status": {"type": "string", "enum": ["passed", "failed"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean_worktree", "setup", "smoke", "validation", "artifact_policy"],
          "properties": {
            "clean_worktree": {"type": "string", "enum": ["passed", "failed"]},
            "setup": {"type": "string", "enum": ["passed", "failed", "not-run"]},
            "smoke": {"type": "string", "enum": ["passed", "failed", "not-run"]},
            "validation": {"type": "string", "enum": ["passed", "failed", "not-run", "declared-missing"]},
            "artifact_policy": {"type": "string", "enum": ["passed", "failed"]}
          }
        },
        "binding": {
          "oneOf": [
            {"$ref": "#/$defs/enabledBinding"},
            {"$ref": "#/$defs/disabledBinding"}
          ]
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "binding": {"$ref": "#/$defs/enabledBinding"},
              "checks": {
                "properties": {
                  "clean_worktree": {"const": "passed"},
                  "setup": {"const": "passed"},
                  "smoke": {"const": "passed"},
                  "validation": {"enum": ["passed", "declared-missing"]},
                  "artifact_policy": {"const": "passed"}
                }
              },
              "findings": {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["severity"],
                    "properties": {"severity": {"const": "error"}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {"properties": {"binding": {"$ref": "#/$defs/disabledBinding"}}}
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "adapter", "enable_transition"],
      "properties": {
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft_owner", "enable_owner", "initial_enabled"],
          "properties": {
            "draft_owner": {"const": "project-add"},
            "enable_owner": {"const": "onboarding-gate"},
            "initial_enabled": {"const": false}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft_owner", "provision_owner", "storage"],
          "properties": {
            "draft_owner": {"const": "project-add"},
            "provision_owner": {"const": "provision-agent"},
            "storage": {"const": "secretary-instance/adapters/<project>.yaml"}
          }
        },
        "enable_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["only_when", "forbidden_owners"],
          "properties": {
            "only_when": {"const": "gate.status == passed"},
            "forbidden_owners": {
              "type": "array",
              "prefixItems": [{"const": "deterministic-scanner"}, {"const": "project-add"}, {"const": "provision-agent"}],
              "items": false,
              "minItems": 3
            }
          }
        }
      }
    },
    "compatibilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "role", "canonical_source"],
      "properties": {
        "consumer": {"const": "legacy-dispatcher"},
        "role": {"const": "derived-transition-consumer"},
        "canonical_source": {"const": "onboarding-contract-v1"}
      }
    },
    "disabledBinding": {
      "allOf": [
        {"$ref": "#/$defs/bindingBase"},
        {"type": "object", "properties": {"enabled": {"const": false}}}
      ]
    },
    "enabledBinding": {
      "allOf": [
        {"$ref": "#/$defs/bindingBase"},
        {"type": "object", "properties": {"enabled": {"const": true}}}
      ]
    },
    "bindingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "enabled", "adapter", "default_branch"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repo": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "adapter": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1},
        "plane": {"type": "string", "enum": ["orchestrator", "project", "memory", "ops"]},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code_concurrency": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "adapterDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "smoke", "validation", "artifact_policy"],
      "properties": {
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands"],
          "properties": {
            "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {"type": "string", "minLength": 1}
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ci"],
          "properties": {
            "ci": {"type": "string", "enum": ["github", "local", "none"]},
            "command": {"type": "string", "minLength": 1},
            "missing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [
            {
              "if": {"required": ["ci"], "properties": {"ci": {"const": "local"}}},
              "then": {"required": ["command"]}
            },
            {
              "if": {"required": ["ci"], "properties": {"ci": {"const": "none"}}},
              "then": {"required": ["missing"]}
            }
          ]
        },
        "artifact_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["write_project_files"],
          "properties": {
            "write_project_files": {"type": "boolean"}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["repo.missing", "scanner.failed", "draft.invalid", "ci.undeclared", "gate.failed"]
        },
        "severity": {"type": "string", "enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
