{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter.schema.json",
  "title": "Project adapter",
  "description": "How the pipeline sets up, smoke-checks and validates a project (secretary-instance/adapters/<id>.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["setup", "smoke", "validation", "artifact_policy"],
  "properties": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Setup commands run on a clean worktree."
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci"],
      "properties": {
        "ci": {
          "type": "string",
          "enum": ["github", "local", "none"],
          "description": "Where validation runs. 'none' must be justified by 'missing'."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Local validation command when ci is 'local'."
        },
        "missing": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "What the gate could not cover, e.g. ['tests']."
        }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_project_files"],
      "properties": {
        "write_project_files": {
          "type": "boolean",
          "description": "Whether the pipeline may write files into the project repo."
        }
      }
    }
  }
}
