#!/bin/sh
# The role launcher supplies these bindings from the configured product, never the candidate.
if [ ! -x "${UMMANU_DOCKER_PYTHON:-}" ] || [ ! -r "${UMMANU_DOCKER_SOURCE:-}/ummanu/runtime/docker_guard.py" ]; then
    printf '%s\n' 'docker-guard: product runtime unavailable; repair the role launch' >&2
    exit 125
fi
exec "$UMMANU_DOCKER_PYTHON" -I -c 'import sys
sys.path.insert(0, sys.argv.pop(1))
try:
    from ummanu.runtime.docker_guard import main
except ImportError:
    print("docker-guard: product module unavailable; repair the role launch", file=sys.stderr)
    sys.exit(125)
sys.exit(main())' "$UMMANU_DOCKER_SOURCE" "$@"
