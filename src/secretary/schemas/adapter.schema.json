{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter.schema.json",
  "title": "Project adapter",
  "description": "How the pipeline sets up, smoke-checks and validates a project (secretary-instance/adapters/<id>.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["setup", "smoke", "validation", "artifact_policy"],
  "properties": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Setup commands run on a clean worktree."
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci"],
      "properties": {
        "ci": {
          "type": "string",
          "enum": ["github", "local", "none"],
          "description": "Where validation runs. 'local' needs a command, 'none' must be justified by 'missing'."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Local validation command, required when ci is 'local'."
        },
        "missing": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "What the gate could not cover, e.g. ['tests']. Required when ci is 'none'."
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "description": "GitHub check names the gate judges by, e.g. ['test']. Matches an Actions check-run name or a legacy commit status context. Only meaningful when ci is 'github'; without it the gate judges by every check on the sha."
        }
      },
      "allOf": [
        {
          "if": {"required": ["ci"], "properties": {"ci": {"const": "local"}}},
          "then": {"required": ["command"]}
        },
        {
          "if": {"required": ["ci"], "properties": {"ci": {"const": "none"}}},
          "then": {"required": ["missing"]}
        }
      ]
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_project_files"],
      "properties": {
        "write_project_files": {
          "type": "boolean",
          "description": "Whether the pipeline may write files into the project repo."
        }
      }
    }
  }
}
