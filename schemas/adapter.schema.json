{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretary.local/schemas/adapter.schema.json",
  "title": "Secretary project adapter",
  "type": "object",
  "required": ["setup", "smoke", "validation", "artifact_policy"],
  "properties": {
    "$schema": { "type": "string" },
    "setup": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "smoke": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "validation": { "type": "object" },
    "artifact_policy": { "type": "object" }
  },
  "additionalProperties": false
}
